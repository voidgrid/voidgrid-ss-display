[Unit]
Description=SteelSeries OLED display stats
# No ordering on the keyboard: a user unit cannot wait for a system unit or device.
# If the keyboard is not ready yet the script exits non-zero and Restart= tries again.

[Service]
Type=simple
WorkingDirectory=%h/projects/ss-display/ss-display
ExecStart=/usr/bin/python3 ss-display.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
